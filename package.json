{
  "name": "classapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run infini:build && npm run zstd:build",
    "dev": "node scripts/dev/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/dev.ts",
    "dev:client": "vite",
    "infini:build": "node scripts/builds/build-infini.mjs",
    "zstd:build": "node scripts/builds/build-zstd-web.mjs",
    "pdfrender:update": "node scripts/dev/update-pdfrender.mjs",
    "build": "node scripts/builds/build.mjs",
    "test:e2e": "CLASSAPP_REQUIRE_HTTPS=1 npm run build -- linux-redhat && node --import tsx scripts/tests/test-e2e.mts",
    "test:manual": "npm run build -- linux-redhat && node --import tsx scripts/tests/test-manual.mts",
    "test:manual-legacy": "npm run build -- linux-redhat && node --import tsx scripts/tests/test-manual-legacy.mts",
    "reset": "node scripts/dev/reset-dev.mjs",
    "https:check": "node scripts/operation/duckdns-certificate.mjs --check",
    "https:renew": "node scripts/operation/duckdns-certificate.mjs --renew --agree-tos",
    "prelint": "npm run infini:build && npm run zstd:build",
    "lint": "tsc --noEmit && eslint",
    "format": "prettier . --write"
  },
  "browserslist": [
    "chrome >=70"
  ],
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "better-sqlite3": "^13.0.1",
    "bufferutil": "^4.1.0",
    "cheerio": "^1.2.0",
    "core-js": "^3.49.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.4",
    "openai": "^7.4.0",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamdown": "^2.5.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "acme-client": "^5.4.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  }
}
